import os
from typing import Optional, Sequence, Union

__version__: str

class TaylorError(Exception): ...
class ManifestError(TaylorError): ...
class TemplateError(TaylorError): ...
class SigningError(TaylorError): ...

def encode_manifest(manifest_json: str) -> bytes: ...
def build_envelope(
    manifest_json: str,
    key_pem: Optional[str] = None,
    key_path: Optional[Union[str, os.PathLike[str]]] = None,
    manifest_digest: str = "sha256",
) -> bytes: ...
def render_template(
    template_path: Union[str, os.PathLike[str]],
    variables_json: Optional[str] = None,
    vars_file: Optional[Union[str, os.PathLike[str]]] = None,
) -> str: ...
def run_cli(argv: Sequence[Union[str, os.PathLike[str]]]) -> int: ...
